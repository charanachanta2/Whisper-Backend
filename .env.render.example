# Add these in Render's Environment settings (Render dashboard > your
# service > Environment). Do not commit real values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=music_chat
INVITE_SECRET=replace-with-a-long-random-secret
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
CLIENT_ORIGIN=*
# Set this to your Render service's own URL (e.g.
# https://music-chat-server.onrender.com). It's used to build the links to
# uploaded photos/videos/files so they work for every chat member, not just
# whoever's phone happens to match the request host.
PUBLIC_BASE_URL=https://YOUR-RENDER-SERVICE.onrender.com
# Voice chat: create a free project at https://cloud.livekit.io, then copy
# these three values from Settings > Keys. LIVEKIT_URL is the wss:// URL
# shown there (not an https:// one). Voice rooms return a clear "not
# configured" error until all three are set -- everything else in the app
# works without them.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
