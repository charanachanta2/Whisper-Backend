CLIENT_ORIGIN=*
MONGODB_URI=
MONGODB_DB=music_chat
INVITE_SECRET=change-me-invite-secret
ADMIN_SESSION_SECRET=change-me-session-secret
# Optional locally (defaults to the request host); set it in production so
# uploaded photo/video/file links are always correct.
PUBLIC_BASE_URL=

# Optional: OS push notifications (iPhone home-screen app). Generate once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Cloudflare R2 storage for photos, videos and voice messages (see DEPLOYMENT.md).
# Leave empty to store uploads on the server's disk instead (development only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public address of the bucket, no trailing slash, e.g. https://media.yourdomain.com
R2_PUBLIC_URL=
